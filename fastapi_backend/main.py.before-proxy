import os
import json
import time
import uuid
import tempfile
import subprocess
from pathlib import Path
from typing import Optional

import boto3
from fastapi import FastAPI, Request, HTTPException
from fastapi.responses import JSONResponse, Response, FileResponse
from google import genai
from google.genai import types

app = FastAPI(
    title="AI-Dinmagic FastAPI",
    version="1.0.0"
)

TMP = Path(tempfile.gettempdir())

jobs = {}
export_jobs = {}


# ============================================================
# HELPERS
# ============================================================

def get_gemini_client(api_key: Optional[str] = None):
    key = api_key or os.getenv("GEMINI_API_KEY")
    if not key:
        raise RuntimeError(
            "Gemini API Key មិនត្រូវបានកំណត់។ "
            "សូមបញ្ចូល Gemini API Key ក្នុង App Settings។"
        )
    return genai.Client(api_key=key)


def run_command(command):
    result = subprocess.run(
        command,
        shell=True,
        capture_output=True,
        text=True
    )

    if result.returncode != 0:
        raise RuntimeError(
            f"Command failed ({result.returncode}): "
            f"{result.stderr[-1000:]}"
        )

    return result.stdout


def format_timestamp(seconds):
    seconds = float(seconds)
    minutes = int(seconds // 60)
    secs = seconds % 60
    return f"{minutes}:{secs:04.1f}"


def cleanup_file(path):
    try:
        Path(path).unlink(missing_ok=True)
    except Exception:
        pass


# ============================================================
# HEALTH
# ============================================================

@app.get("/")
def root():
    return {
        "status": "running",
        "service": "AI-Dinmagic FastAPI"
    }


@app.get("/health")
def health():
    return {
        "status": "ok"
    }


# ============================================================
# UPLOAD CHUNK
# ============================================================

@app.post("/api/upload-chunk")
async def upload_chunk(request: Request):
    file_id = request.query_params.get("fileId")
    chunk_index = request.query_params.get("chunkIndex")

    if not file_id:
        raise HTTPException(
            status_code=400,
            detail="Missing fileId in query"
        )

    if chunk_index is None:
        raise HTTPException(
            status_code=400,
            detail="Missing chunkIndex in query"
        )

    body = await request.body()

    if not body:
        raise HTTPException(
            status_code=400,
            detail="No chunk body provided"
        )

    chunk_path = TMP / f"upload_{file_id}_part_{chunk_index}"
    chunk_path.write_bytes(body)

    return {
        "success": True
    }


# ============================================================
# TRANSCRIBE START
# ============================================================

@app.post("/api/transcribe/start")
async def transcribe_start(request: Request):

    body = await request.json()

    file_id = body.get("fileId")
    mimetype = body.get("mimetype", "")
    model = body.get("model")
    workflow = body.get("workflow")
    total_chunks = int(body.get("totalChunks") or 0)

    if not file_id:
        raise HTTPException(
            status_code=400,
            detail="Missing fileId"
        )

    api_key = request.headers.get("x-api-key")

    aws_access_key = request.headers.get("x-aws-access-key-id")
    aws_secret_key = request.headers.get("x-aws-secret-access-key")
    aws_region = (
        request.headers.get("x-aws-region")
        or os.getenv("AWS_REGION")
        or "ap-southeast-2"
    )
    aws_bucket = (
        request.headers.get("x-aws-s3-bucket")
        or os.getenv("AWS_S3_BUCKET")
    )

    job_id = str(int(time.time() * 1000))

    jobs[job_id] = {
        "status": "starting",
        "progress": 40
    }

    # --------------------------------------------------------
    # Merge chunks
    # --------------------------------------------------------

    file_path = TMP / f"upload_{file_id}"

    try:
        if file_path.exists():
            file_path.unlink()

        with file_path.open("wb") as output:

            for i in range(total_chunks):

                chunk_path = TMP / f"upload_{file_id}_part_{i}"

                if not chunk_path.exists():
                    jobs[job_id] = {
                        "status": "error",
                        "progress": 0,
                        "error": f"Missing chunk {i}"
                    }

                    return {
                        "jobId": job_id
                    }

                output.write(chunk_path.read_bytes())
                chunk_path.unlink()

        if not file_path.exists():
            raise RuntimeError("File not found on server")

    except Exception as exc:

        jobs[job_id] = {
            "status": "error",
            "progress": 0,
            "error": str(exc)
        }

        return {
            "jobId": job_id
        }

    # --------------------------------------------------------
    # Background processing
    # --------------------------------------------------------

    import asyncio

    asyncio.create_task(
        process_transcription(
            job_id=job_id,
            file_path=file_path,
            mimetype=mimetype,
            model=model,
            workflow=workflow,
            api_key=api_key,
            aws_access_key=aws_access_key,
            aws_secret_key=aws_secret_key,
            aws_region=aws_region,
            aws_bucket=aws_bucket,
        )
    )

    return {
        "jobId": job_id
    }


# ============================================================
# TRANSCRIPTION PROCESSOR
# ============================================================

async def process_transcription(
    job_id,
    file_path,
    mimetype,
    model,
    workflow,
    api_key,
    aws_access_key,
    aws_secret_key,
    aws_region,
    aws_bucket,
):

    audio_path = None

    try:

        # ----------------------------------------------------
        # Gemini client
        # ----------------------------------------------------

        ai = get_gemini_client(api_key)

        # ----------------------------------------------------
        # Determine workflow
        # ----------------------------------------------------

        if workflow in ("amazon", "aws"):
            active_workflow = "amazon"
        else:
            active_workflow = "gemini"

        active_model = (
            model
            if model and model != "amazon"
            else "gemini-2.5-flash"
        )

        # ----------------------------------------------------
        # Extract audio from video
        # ----------------------------------------------------

        is_video = (
            mimetype.startswith("video/")
            or mimetype == "application/octet-stream"
            or mimetype == ""
        )

        upload_path = file_path
        upload_mime = mimetype

        if is_video:

            jobs[job_id] = {
                "status": "extracting audio",
                "progress": 42
            }

            audio_path = TMP / f"audio_{job_id}.mp3"

            run_command(
                f'ffmpeg -hide_banner -loglevel error '
                f'-i "{file_path}" '
                f'-vn -acodec libmp3lame -q:a 2 '
                f'"{audio_path}" -y'
            )

            upload_path = audio_path
            upload_mime = "audio/mpeg"

        # ====================================================
        # AWS TRANSCRIBE
        # ====================================================

        if active_workflow == "amazon":

            if not aws_access_key or not aws_secret_key:
                raise RuntimeError(
                    "AWS Credentials មិនទាន់បានបំពេញ។"
                )

            if not aws_bucket:
                raise RuntimeError(
                    "AWS S3 Bucket មិនទាន់បានបំពេញ។"
                )

            jobs[job_id] = {
                "status": "uploading to s3",
                "progress": 45
            }

            s3 = boto3.client(
                "s3",
                region_name=aws_region,
                aws_access_key_id=aws_access_key,
                aws_secret_access_key=aws_secret_key,
            )

            transcribe = boto3.client(
                "transcribe",
                region_name=aws_region,
                aws_access_key_id=aws_access_key,
                aws_secret_access_key=aws_secret_key,
            )

            s3_key = f"uploads/{job_id}_audio.mp3"

            with open(upload_path, "rb") as audio_file:

                s3.upload_fileobj(
                    audio_file,
                    aws_bucket,
                    s3_key
                )

            jobs[job_id] = {
                "status": "transcribing with amazon",
                "progress": 50
            }

            transcribe_job_name = f"TranscribeJob_{job_id}"

            transcribe.start_transcription_job(
                TranscriptionJobName=transcribe_job_name,
                IdentifyLanguage=True,
                MediaFormat="mp3",
                Media={
                    "MediaFileUri":
                        f"s3://{aws_bucket}/{s3_key}"
                }
            )

            retry = 0

            while True:

                await __import__("asyncio").sleep(5)

                result = transcribe.get_transcription_job(
                    TranscriptionJobName=transcribe_job_name
                )

                status = result[
                    "TranscriptionJob"
                ]["TranscriptionJobStatus"]

                if status == "COMPLETED":
                    break

                if status == "FAILED":
                    reason = result[
                        "TranscriptionJob"
                    ].get("FailureReason", "")

                    raise RuntimeError(
                        "AWS Transcribe failed: " + reason
                    )

                retry += 1

                jobs[job_id] = {
                    "status": "transcribing with amazon",
                    "progress": min(
                        85,
                        50 + retry * 2
                    )
                }

            transcript_uri = result[
                "TranscriptionJob"
            ]["Transcript"]["TranscriptFileUri"]

            import urllib.request

            with urllib.request.urlopen(
                transcript_uri
            ) as response:

                transcript = json.loads(
                    response.read()
                )

            items = transcript.get(
                "results", {}
            ).get("items", [])

            original_lines = []

            current_line = None
            word_count = 0

            for item in items:

                if item.get("type") == "pronunciation":

                    start = item["start_time"]
                    end = item["end_time"]
                    text = item[
                        "alternatives"
                    ][0]["content"]

                    if current_line is None:

                        current_line = {
                            "id": str(uuid.uuid4()),
                            "start": start,
                            "end": end,
                            "text": text
                        }

                        word_count = 1

                    else:

                        gap = (
                            float(start)
                            - float(current_line["end"])
                        )

                        duration = (
                            float(end)
                            - float(current_line["start"])
                        )

                        punctuation = (
                            current_line["text"]
                            .endswith((".", "!", "?"))
                        )

                        if (
                            gap > 0.5
                            or duration > 3.5
                            or word_count >= 10
                            or (
                                punctuation
                                and gap > 0.2
                            )
                        ):

                            original_lines.append(
                                current_line
                            )

                            current_line = {
                                "id": str(uuid.uuid4()),
                                "start": start,
                                "end": end,
                                "text": text
                            }

                            word_count = 1

                        else:

                            current_line["end"] = end
                            current_line["text"] += (
                                " " + text
                            )

                            word_count += 1

                elif (
                    item.get("type") == "punctuation"
                    and current_line
                ):

                    current_line["text"] += (
                        item["alternatives"][0]["content"]
                    )

            if current_line:
                original_lines.append(
                    current_line
                )

            if not original_lines:
                raise RuntimeError(
                    "AWS Transcribe មិនអាចស្គាល់សំឡេងបានទេ។"
                )

            original_lines = [
                {
                    "id": line["id"],
                    "start": format_timestamp(
                        line["start"]
                    ),
                    "end": format_timestamp(
                        line["end"]
                    ),
                    "text": line["text"]
                }
                for line in original_lines
            ]

            # ------------------------------------------------
            # Gemini translation
            # ------------------------------------------------

            jobs[job_id] = {
                "status": "translating to khmer",
                "progress": 90,
                "lines": []
            }

            translated_lines = []

            for offset in range(
                0,
                len(original_lines),
                40
            ):

                chunk = original_lines[
                    offset:offset + 40
                ]

                prompt = f"""
You are a professional subtitle translator.

Translate the following subtitle JSON array
into Khmer (Cambodian).

STRICT RULES:

1. Translate ONLY the "text" field.
2. NEVER change "id".
3. NEVER change "start".
4. NEVER change "end".
5. Return EXACTLY the same number of objects.
6. Keep EXACT object order.
7. Do NOT merge subtitles.
8. Do NOT split subtitles.
9. Do NOT omit subtitles.
10. Do NOT add subtitles.
11. Do NOT summarize.
12. Do NOT invent information.
13. ALL translated text must be Khmer.
14. Return ONLY valid JSON.

SOURCE SUBTITLES:
{json.dumps(chunk, ensure_ascii=False)}
"""

                response = ai.models.generate_content(
                    model=active_model,
                    contents=prompt,
                    config=types.GenerateContentConfig(
                        response_mime_type="application/json"
                    )
                )

                parsed = json.loads(
                    response.text
                )

                if not isinstance(parsed, list):
                    raise RuntimeError(
                        "Gemini translation response "
                        "is not an array."
                    )

                if len(parsed) != len(chunk):
                    raise RuntimeError(
                        f"Gemini returned {len(parsed)} "
                        f"lines, expected {len(chunk)}."
                    )

                for index, original in enumerate(chunk):

                    text = str(
                        parsed[index].get("text", "")
                    ).strip()

                    if not text:
                        raise RuntimeError(
                            f"Empty translation at index {index}"
                        )

                    translated_lines.append({
                        "id": original["id"],
                        "start": original["start"],
                        "end": original["end"],
                        "text": text
                    })

            jobs[job_id] = {
                "status": "done",
                "progress": 100,
                "lines": translated_lines
            }

            try:
                s3.delete_object(
                    Bucket=aws_bucket,
                    Key=s3_key
                )
            except Exception:
                pass

            return

        # ====================================================
        # GEMINI DIRECT TRANSCRIPTION
        # ====================================================

        jobs[job_id] = {
            "status": "uploading to gemini",
            "progress": 45
        }

        with open(upload_path, "rb") as f:
            uploaded = ai.files.upload(
                file=f,
                config={
                    "mime_type": upload_mime
                }
            )

        jobs[job_id] = {
            "status": "processing video",
            "progress": 50
        }

        file_state = ai.files.get(
            name=uploaded.name
        )

        retry = 0

        while (
            getattr(file_state, "state", None)
            and str(file_state.state).upper()
            == "PROCESSING"
            and retry < 40
        ):

            await __import__("asyncio").sleep(3)

            file_state = ai.files.get(
                name=uploaded.name
            )

            retry += 1

            jobs[job_id] = {
                "status": "processing video",
                "progress": 50 + min(
                    retry * 2,
                    20
                )
            }

        if (
            str(
                getattr(
                    file_state,
                    "state",
                    ""
                )
            ).upper()
            == "FAILED"
        ):
            raise RuntimeError(
                "Video processing failed on Gemini side."
            )

        jobs[job_id] = {
            "status": "generating subtitles",
            "progress": 75
        }

        prompt = """
You are an expert professional subtitle transcriber and translator.

TASK:
Listen to and process the ENTIRE audio/video from beginning to end.
Do NOT summarize the content.

TRANSCRIPTION AND SEGMENTATION RULES:
1. Capture EVERY spoken dialogue.
2. Do not omit, summarize, or paraphrase speech.
3. Preserve chronological order.
4. Create MANY short sequential subtitle segments.
5. Prefer approximately 1-6 seconds per segment.
6. Split long sentences at natural pauses.
7. Do NOT combine multiple separate sentences into one subtitle.
8. Do NOT create only a small number of large blocks.
9. Use accurate timestamps.
10. Continue until the END.
11. Do not invent dialogue during silence.
12. Preserve chronological order for multiple speakers.
13. ALL subtitle text must be natural Khmer.
14. Do NOT output original-language transcript.
15. Do NOT summarize.

IMPORTANT:
Do NOT reduce the entire video to a small number
of subtitle entries to save tokens.

OUTPUT:
Return ONLY a valid JSON array.

Each object:
{
  "id": "1",
  "start": "M:SS.S",
  "end": "M:SS.S",
  "text": "Khmer"
}

IDs must be sequential.
"""

        response = ai.models.generate_content(
            model=active_model,
            contents=[
                prompt,
                uploaded
            ],
            config=types.GenerateContentConfig(
                response_mime_type="application/json"
            )
        )

        lines = json.loads(
            response.text
        )

        if not isinstance(lines, list) or not lines:
            raise RuntimeError(
                "Gemini មិនបានបង្កើត subtitle lines ទេ។"
            )

        jobs[job_id] = {
            "status": "done",
            "progress": 100,
            "lines": lines
        }

        try:
            ai.files.delete(
                name=uploaded.name
            )
        except Exception:
            pass

    except Exception as exc:

        print(
            f"[TRANSCRIBE ERROR] {exc}"
        )

        jobs[job_id] = {
            "status": "error",
            "progress": 0,
            "error": str(exc)
        }

    finally:

        cleanup_file(file_path)

        if audio_path:
            cleanup_file(audio_path)


# ============================================================
# TRANSCRIBE STATUS
# ============================================================

@app.get("/api/transcribe/status")
def transcribe_status(jobId: str):

    job = jobs.get(jobId)

    if not job:
        raise HTTPException(
            status_code=404,
            detail="Job not found"
        )

    return job


# ============================================================
# DEBUG JOBS
# ============================================================

@app.get("/api/debug/jobs")
def debug_jobs():

    result = {}

    for job_id, job in jobs.items():

        result[job_id] = {
            "status": job.get("status"),
            "progress": job.get("progress"),
            "error": job.get("error"),
            "linesCount": len(
                job.get("lines", [])
            )
        }

    return result


# ============================================================
# AWS TEST
# ============================================================

@app.post("/api/test-aws")
async def test_aws(request: Request):

    access_key = request.headers.get(
        "x-aws-access-key-id"
    )
    secret_key = request.headers.get(
        "x-aws-secret-access-key"
    )
    region = request.headers.get(
        "x-aws-region"
    ) or "ap-southeast-2"
    bucket = request.headers.get(
        "x-aws-s3-bucket"
    )

    if not access_key or not secret_key or not bucket:

        raise HTTPException(
            status_code=400,
            detail="សូមបំពេញ AWS Keys និង S3 Bucket ឱ្យបានពេញលេញសិន"
        )

    try:

        s3 = boto3.client(
            "s3",
            region_name=region,
            aws_access_key_id=access_key,
            aws_secret_access_key=secret_key,
        )

        s3.list_objects_v2(
            Bucket=bucket,
            MaxKeys=1
        )

        return {
            "success": True,
            "message":
                "AWS Keys និង Bucket របស់អ្នកត្រឹមត្រូវ អាចប្រើបាន!"
        }

    except Exception as exc:

        raise HTTPException(
            status_code=400,
            detail="បញ្ហាភ្ជាប់ទៅ AWS: " + str(exc)
        )


# ============================================================
# TTS
# ============================================================

@app.post("/api/tts")
async def tts(request: Request):

    data = await request.json()

    text = data.get("text")
    voice = data.get("voice")

    if not text:
        raise HTTPException(
            status_code=400,
            detail="Missing text"
        )

    try:

        import edge_tts

        target_voice = (
            "km-KH-SreymomNeural"
            if voice == "Sreymom"
            else "km-KH-PisethNeural"
        )

        output = TMP / (
            f"tts_{uuid.uuid4().hex}.mp3"
        )

        communicator = edge_tts.Communicate(
            text,
            target_voice
        )

        await communicator.save(
            str(output)
        )

        audio = output.read_bytes()

        cleanup_file(output)

        return Response(
            content=audio,
            media_type="audio/mpeg"
        )

    except Exception as exc:

        print(
            f"[TTS ERROR] {exc}"
        )

        raise HTTPException(
            status_code=500,
            detail=str(exc)
        )
